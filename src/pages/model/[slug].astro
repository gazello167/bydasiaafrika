  /* Kursor zoom pada gambar utama slider */
  .gallery-slide.active img {
    cursor: zoom-in;
    transition: transform 0.2s ease;
  }
  .gallery-slide.active:hover img {
    transform: scale(1.015);
  }

  /* Lightbox Overlay */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(15, 17, 21, 0.92);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lb-stage {
    max-width: 92vw;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .lb-stage img {
    max-width: 92vw;
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    user-select: none;
  }
  .lb-caption {
    color: #e5e7eb;
    font-size: 0.9rem;
    text-align: center;
  }
  .lb-close {
    position: fixed;
    top: 16px;
    right: 20px;
    z-index: 10001;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .lb-close:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .lb-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10001;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 1.25rem;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .lb-nav:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .lb-prev { left: 16px; }
  .lb-next { right: 16px; }
  .lb-nav[hidden] { display: none; }

  /* -------- Model Lainnya (2 kolom mobile, 3 kolom desktop) -------- */
  .other-models-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 16px;
  }
  @media (min-width: 960px) {
    .other-models-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
  }

  .other-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 14px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  @media (min-width: 960px) {
    .other-card {
      display: grid;
      grid-template-columns: 1fr 48%;
      align-items: center;
      gap: 10px;
      padding: 20px;
