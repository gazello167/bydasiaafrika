  }
  @media (min-width: 960px) {
    .other-media {
      margin-bottom: 0;
    }
  }
  .other-media img,
  .other-media svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .other-info h3 {
    margin: 0 0 6px;
    font-size: 1rem;
  }
  @media (min-width: 960px) {
    .other-info h3 {
      font-size: 1.15rem;
    }
  }
  .other-info h3 a {
    text-decoration: none;
  }
  .other-info h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .other-info .price-label {
    margin: 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .other-info .price {
    margin: 0 0 8px;
    font-size: 0.92rem;
    font-weight: 700;
  }
  @media (min-width: 960px) {
    .other-info .price {
      font-size: 1rem;
    }
  }
</style>

<script>
  // Slider + Lightbox
  const slider = document.getElementById('mainSlider');
  const thumbs = document.getElementById('thumbs');
  const lightbox = document.getElementById('galleryLightbox');
  const lbImg = document.getElementById('lbImg');
  const lbCaption = document.getElementById('lbCaption');
  const lbClose = document.getElementById('lbClose');
  const lbPrev = document.getElementById('lbPrev');
  const lbNext = document.getElementById('lbNext');

  if (slider) {
    const slides = Array.from(slider.querySelectorAll('.gallery-slide'));
    const buttons = thumbs ? Array.from(thumbs.querySelectorAll('.gallery-thumb')) : [];
    let currentIdx = 0;

    const setActiveSlide = (idx) => {
      currentIdx = (idx + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('active', i === currentIdx));
      buttons.forEach((b, i) => b.classList.toggle('active', i === currentIdx));
    };

    if (thumbs) {
      thumbs.addEventListener('click', (e) => {
        const btn = e.target.closest('.gallery-thumb');
        if (!btn) return;
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        setActiveSlide(idx);
      });
    }

    const updateLightbox = () => {
      if (!lightbox || !lbImg) return;
      const activeImg = slides[currentIdx]?.querySelector('img');
      if (!activeImg) return;
      lbImg.src = activeImg.currentSrc || activeImg.src;
      lbImg.alt = activeImg.alt || '';
      if (lbCaption) {
        lbCaption.textContent = `${activeImg.alt || ''} (${currentIdx + 1} / ${slides.length})`;
      }
      const single = slides.length <= 1;
      if (lbPrev) lbPrev.hidden = single;
      if (lbNext) lbNext.hidden = single;
    };

    const openLightbox = () => {
      if (!lightbox) return;
      updateLightbox();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.hidden = true;
      document.body.style.overflow = '';
    };

    // Klik pada gambar aktif di slider -> buka Lightbox
    slider.addEventListener('click', (e) => {
      const clickedImg = e.target.closest('.gallery-slide.active img');
      if (clickedImg) openLightbox();
    });

    if (lbClose) lbClose.addEventListener('click', closeLightbox);
    if (lbPrev) {
      lbPrev.addEventListener('click', (e) => {
        e.stopPropagation();
        setActiveSlide(currentIdx - 1);
        updateLightbox();
      });
    }
    if (lbNext) {
      lbNext.addEventListener('click', (e) => {
        e.stopPropagation();
        setActiveSlide(currentIdx + 1);
        updateLightbox();
      });
    }

    // Klik backdrop gelap -> tutup
    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
    }

    // Navigasi keyboard (Esc, Panah Kiri/Kanan)
    document.addEventListener('keydown', (e) => {
      if (!lightbox || lightbox.hidden) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft' && slides.length > 1) {
        setActiveSlide(currentIdx - 1);
        updateLightbox();
      }
      if (e.key === 'ArrowRight' && slides.length > 1) {
        setActiveSlide(currentIdx + 1);
        updateLightbox();
      }
    });
  }

  const tabsEl = document.getElementById('tabs');
  if (tabsEl) {
    const nav = tabsEl.querySelector('.tabs-nav');
    if (nav) {
      nav.addEventListener('click', (e) => {
        const btn = e.target.closest('.tab-btn');
        if (!btn) return;
        const tab = btn.getAttribute('data-tab');
        if (!tab) return;
        nav.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('active'));
        tabsEl.querySelectorAll('.tab-pane').forEach((p) => p.classList.remove('active'));
        btn.classList.add('active');
        const pane = tabsEl.querySelector('#tab-' + tab);
        if (pane) pane.classList.add('active');

        // Lazy-load PDF iframe hanya saat tab brosur dibuka
        if (tab === 'brosur') {
          const iframe = document.getElementById('brosurIframe');
          if (iframe && !iframe.getAttribute('src')) {
            const pdfSrc = iframe.getAttribute('data-src');
            if (pdfSrc) iframe.setAttribute('src', pdfSrc);
          }
        }
      });
    }
  }
</script>