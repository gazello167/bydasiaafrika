---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModelCard from '../../components/ModelCard.astro';
import { models } from '../../data/models';
---
<BaseLayout
  title="Model Mobil BYD | Dealer BYD Asia Afrika Bandung"
  description="Daftar model mobil listrik BYD yang tersedia di dealer Asia Afrika Bandung: spesifikasi, harga, dan test drive."
>
  <section class="section">
    <div class="container">
      <h1>Model Mobil BYD</h1>
      <div class="grid">
        {models.map((m) => <ModelCard model={m} />)}
      </div>
    </div>
  </section>
</BaseLayout>
