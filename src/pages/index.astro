---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import ModelCatalog from '../components/ModelCatalog.astro';
import QuickLinks from '../components/QuickLinks.astro';
import Discover from '../components/Discover.astro';
import { site, waLink } from '../data/site';
---
<BaseLayout
  title="Dealer BYD Asia Afrika Bandung | Test Drive & Simulasi Kredit"
  description="Dealer BYD di Jl. Asia Afrika, Bandung. Lihat model, harga, simulasi kredit, dan jadwalkan test drive mobil listrik BYD."
>
  <HeroSlider />
  <ModelCatalog />

  <section class="section">
    <div class="container">
      <QuickLinks />
    </div>
  </section>

  <Discover limit={6} />

  <section class="section">
    <div class="container">
      <h2 class="section-title">Kunjungi Showroom</h2>
      <p class="section-sub">
        {site.address.street}, {site.address.city}, {site.address.region}
      </p>
      <p style="text-align:center">
        <a class="btn secondary" href="/kontak">Lokasi & jam buka</a>
        <a class="btn" href={waLink('Halo, saya ingin tanya lokasi dan jam buka showroom.')} target="_blank" rel="noopener">Tanya via WhatsApp</a>
      </p>
    </div>
  </section>
</BaseLayout>
