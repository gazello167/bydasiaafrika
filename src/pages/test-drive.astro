---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaForm from '../components/WaForm.astro';
import { models } from '../data/models';
---
<BaseLayout
  title="Test Drive BYD di Bandung | Dealer BYD Asia Afrika"
  description="Jadwalkan test drive mobil listrik BYD di dealer Jl. Asia Afrika, Bandung. Isi form, kami lanjutkan via WhatsApp."
>
  <section class="section">
    <div class="container">
      <h1 class="page-title">Jadwalkan Test Drive</h1>
      <p class="note">Isi data singkat, lalu kami lanjutkan lewat WhatsApp.</p>
      <WaForm
        intro="Halo, saya ingin menjadwalkan test drive."
        fields={[
          { name: 'nama', label: 'Nama', required: true },
          { name: 'model', label: 'Model', type: 'select', options: models.map((m) => m.name) },
          { name: 'tanggal', label: 'Tanggal yang diinginkan', type: 'date' },
        ]}
      />
    </div>
  </section>
</BaseLayout>
