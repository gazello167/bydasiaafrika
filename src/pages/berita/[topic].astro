---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pic from '../../components/Pic.astro';
import { topics, topicBySlug, articlesByTopic, publishedArticles, primaryCategory, formatTanggal } from '../../data/articles';
import { site, waLink } from '../../data/site';

export function getStaticPaths() {
  const paths = topics.map((t) => ({ params: { topic: t.slug } }));
  paths.push({ params: { topic: 'semua' } });
  return paths;
}

const { topic } = Astro.params;
const isAll = topic === 'semua';
const t = topicBySlug(topic);
if (!isAll && !t) return Astro.redirect('/berita');

const articles = isAll ? publishedArticles() : articlesByTopic(topic);
const title = isAll ? 'Semua Artikel' : t.label;
const description = isAll
  ? 'Semua berita, insight, dan promo dari dealer BYD Asia Afrika Bandung.'
  : t.description;
const modelLink = t?.modelSlug ? `/model/${t.modelSlug}` : null;
---

<BaseLayout title={`${title} | Berita ${site.shortName}`} description={description}>
  <section class="section">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a> / <a href="/berita">Berita</a> / {title}
      </nav>

      <h1 class="page-title">{title}</h1>
      <p class="section-sub">{description}</p>

      {modelLink && (
        <p class="topic-cta">
          <a class="btn secondary" href={modelLink}>Lihat harga & spesifikasi {t.label} →</a>
        </p>
      )}

      {articles.length > 0 ? (
        <div class="article-grid">
          {articles.map((a) => {
            const href = `/berita/${primaryCategory(a)}/${a.slug}`;
            return (
              <article class="card">
                <a class="thumb" href={href}>
                  <Pic src={a.image} alt={a.title} width={480} />
                </a>
                <div class="card-body">
                  <div class="topic-badges">
                    {(a.categories || []).map((c) => (
                      <a class="badge-cat" href={`/berita/${c}`}>{topicBySlug(c)?.label ?? c}</a>
                    ))}
                  </div>
                  <h2><a href={href}>{a.title}</a></h2>
                  <p class="excerpt">{a.metaDesc || a.excerpt}</p>
                  <p class="meta">{formatTanggal(a.date)}</p>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="empty">
          <p>Belum ada artikel di topik ini.</p>
          <a class="btn accent" href={waLink(`Halo, saya ingin tanya tentang ${title}.`)} target="_blank" rel="noopener">Tanya kami via WhatsApp</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .topic-cta { text-align: center; margin: 0 0 24px; }
  .article-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 640px) { .article-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .article-grid { grid-template-columns: repeat(3, 1fr); } }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }
  .card .thumb { display: block; aspect-ratio: 16 / 10; background: var(--hero-bg); }
  .card .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .card-body { padding: 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .topic-badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .badge-cat {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .badge-cat:hover { background: var(--accent); color: var(--accent-ink); }
  .card-body h2 { margin: 0; font-size: 1.05rem; }
  .card-body h2 a { text-decoration: none; }
  .excerpt { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .meta { margin: auto 0 0; font-size: 0.8rem; color: var(--muted); }
</style>