---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pic from '../../../components/Pic.astro';
import { publishedArticles, primaryCategory, formatTanggal, topicBySlug } from '../../../data/articles';
import { site } from '../../../data/site';

export function getStaticPaths() {
  return publishedArticles().map((article) => ({
    params: { topic: primaryCategory(article), slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const mainCat = primaryCategory(article);
const topic = topicBySlug(mainCat);
const seoTitle = article.metaTitle?.trim() || `${article.title} | ${site.shortName}`;
const seoDesc = article.metaDesc?.trim() || article.excerpt;
const canonicalUrl = new URL(`/berita/${mainCat}/${article.slug}`, site.url).toString();

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
      headline: article.title,
      description: seoDesc,
      datePublished: article.date,
      dateModified: article.date,
      keywords: article.focusKeyword || undefined,
      image: article.image ? [article.image] : undefined,
      articleSection: (article.categories || []).map((c) => topicBySlug(c)?.label ?? c),
      author: { '@type': 'Organization', name: site.name, url: site.url },
      publisher: { '@type': 'Organization', name: site.name, url: site.url },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Berita', item: `${site.url}/berita` },
        { '@type': 'ListItem', position: 3, name: topic?.label ?? mainCat, item: `${site.url}/berita/${mainCat}` },
        { '@type': 'ListItem', position: 4, name: article.title, item: canonicalUrl },
      ],
    },
    ...(article.faqs && article.faqs.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: article.faqs.map((f) => ({
              '@type': 'Question',
              name: f.question,
              acceptedAnswer: {
                '@type': 'Answer',
                text: f.answer,
              },
            })),
          },
        ]
      : []),
  ],
};
---

<BaseLayout title={seoTitle} description={seoDesc} image={article.image} schema={schema}>
  <article class="section">
    <div class="container prose">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a> / <a href="/berita">Berita</a> /
        <a href={`/berita/${mainCat}`}>{topic?.label ?? mainCat}</a> / {article.title}
      </nav>

      <h1 class="page-title">{article.title}</h1>

      <div class="meta-bar">
        <div class="cat-list">
          {(article.categories || []).map((c) => (
            <a class="cat-pill" href={`/berita/${c}`}>{topicBySlug(c)?.label ?? c}</a>
          ))}
        </div>
        <span class="meta-date">· {formatTanggal(article.date)}</span>
      </div>

      {article.image && <Pic src={article.image} alt={article.title} width={960} eager />}

      {article.content ? (
        <div class="article-body" set:html={article.content} />
      ) : (
        (article.body || []).map((p) => <p>{p}</p>)
      )}

      {article.faqs && article.faqs.length > 0 && (
        <section class="article-faq" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Pertanyaan yang Sering Diajukan (FAQ)</h2>
          <div class="faq-list">
            {article.faqs.map((f, idx) => (
              <details class="faq-item" open={idx === 0}>
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {topic?.modelSlug && (
        <p style="margin-top: 2rem;">
          <a class="btn" href={`/model/${topic.modelSlug}`}>Lihat harga & spesifikasi {topic.label} →</a>
        </p>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .cat-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cat-pill {
    background: var(--surface);
    color: var(--ink);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.78rem;
    padding: 4px 10px;
    border-radius: 999px;
    text-decoration: none;
  }
  .cat-pill:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .meta-date {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .article-body :global(h2) {
    margin-top: 1.8rem;
    margin-bottom: 0.6rem;
    font-size: 1.35rem;
  }
  .article-body :global(h3) {
    margin-top: 1.35rem;
    margin-bottom: 0.45rem;
    font-size: 1.12rem;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.25rem;
    margin-bottom: 1rem;
  }
  .article-faq {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .article-faq h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.3rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    padding: 12px 16px;
  }
  .faq-item summary {
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--muted);
  }
  .faq-item[open] summary::after {
    content: '−';
  }
  .faq-item p {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>