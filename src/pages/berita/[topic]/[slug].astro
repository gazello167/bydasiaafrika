---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pic from '../../../components/Pic.astro';
import { publishedArticles, primaryCategory, formatTanggal, topicBySlug } from '../../../data/articles';
import { models } from '../../../data/models';
import { site, waLink } from '../../../data/site';

export function getStaticPaths() {
  return publishedArticles().map((article) => ({
    params: { topic: primaryCategory(article), slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const mainCat = primaryCategory(article);
const topic = topicBySlug(mainCat);
const relatedModel = topic?.modelSlug ? models.find((m) => m.slug === topic.modelSlug) : undefined;
const relatedArticles = publishedArticles()
  .filter((a) => a.slug !== article.slug && (a.categories || []).includes(mainCat))
  .slice(0, 3);

const seoTitle = article.metaTitle?.trim() || `${article.title} | ${site.shortName}`;
const seoDesc = article.metaDesc?.trim() || article.excerpt;
const canonicalUrl = new URL(`/berita/${mainCat}/${article.slug}`, site.url).toString();

// Bersihkan paragraf kosong (<p></p> atau <p><br></p>) dan newline berlebih dari output AI/CMS
const cleanContent = (article.content || '')
  .replace(/<p>(\s|&nbsp;|<br\s*\/?>)*<\/p>/gi, '')
  .replace(/\n{2,}/g, '\n')
  .trim();

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
      headline: article.title,
      description: seoDesc,
      datePublished: article.date,
      dateModified: article.date,
      keywords: article.focusKeyword || undefined,
      image: article.image ? [article.image] : undefined,
      articleSection: (article.categories || []).map((c) => topicBySlug(c)?.label ?? c),
      author: { '@type': 'Organization', name: site.name, url: site.url },
      publisher: { '@type': 'Organization', name: site.name, url: site.url },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Berita', item: `${site.url}/berita` },
        { '@type': 'ListItem', position: 3, name: topic?.label ?? mainCat, item: `${site.url}/berita/${mainCat}` },
        { '@type': 'ListItem', position: 4, name: article.title, item: canonicalUrl },
      ],
    },
    ...(article.faqs && article.faqs.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: article.faqs.map((f) => ({
              '@type': 'Question',
              name: f.question,
              acceptedAnswer: {
                '@type': 'Answer',
                text: f.answer,
              },
            })),
          },
        ]
      : []),
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={article.image}
  schema={schema}
  modelSlug={topic?.modelSlug}
  waText={`Halo BYD Asia Afrika Bandung, saya baru membaca artikel "${article.title}" dan ingin tanya info lebih lanjut.`}
>
  <article class="article-page">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span>/</span>
        <a href="/berita">Berita</a>
        <span>/</span>
        <a href={`/berita/${mainCat}`}>{topic?.label ?? mainCat}</a>
        <span>/</span>
        <span class="current">{article.title}</span>
      </nav>

      <!-- Header Artikel Lebar Penuh (Sejajar Container Single Model) -->
      <header class="article-header">
        <div class="meta-bar">
          <div class="cat-list">
            {(article.categories || []).map((c) => (
              <a class="cat-pill" href={`/berita/${c}`}>{topicBySlug(c)?.label ?? c}</a>
            ))}
          </div>
          <time class="meta-date" datetime={article.date}>📅 {formatTanggal(article.date)}</time>
        </div>

        <h1 class="article-title">{article.title}</h1>
        {seoDesc && <p class="article-lead">{seoDesc}</p>}
      </header>

      <!-- Grid 2 Kolom Desktop (Konten Utama + Sticky Sidebar) -->
      <div class="article-layout">
        <div class="article-main">
          {article.image && (
            <figure class="featured-media">
              <Pic src={article.image} alt={article.title} width={1080} eager />
            </figure>
          )}

          <div class="article-card">
            {cleanContent ? (
              <div class="article-body" set:html={cleanContent} />
            ) : (
              <div class="article-body">
                {(article.body || []).map((p) => <p>{p}</p>)}
              </div>
            )}

            {article.faqs && article.faqs.length > 0 && (
              <section class="article-faq" aria-labelledby="faq-heading">
                <div class="faq-badge">FAQ</div>
                <h2 id="faq-heading">Pertanyaan yang Sering Diajukan</h2>
                <div class="faq-list">
                  {article.faqs.map((f, idx) => (
                    <details class="faq-item" open={idx === 0}>
                      <summary>{f.question}</summary>
                      <div class="faq-answer">
                        <p>{f.answer}</p>
                      </div>
                    </details>
                  ))}
                </div>
              </section>
            )}
          </div>
        </div>

        <!-- Sticky Sidebar Desktop -->
        <aside class="article-sidebar">
          {relatedModel && (
            <div class="side-card model-promo-card">
              <span class="side-eyebrow">Model Terkait</span>
              <h3>{relatedModel.name}</h3>
              {relatedModel.image && (
                <a href={`/model/${relatedModel.slug}`} class="side-model-img">
                  <Pic src={relatedModel.image} alt={relatedModel.name} width={420} />
                </a>
              )}
              {relatedModel.tagline && <p class="side-tagline">{relatedModel.tagline}</p>}
              <div class="side-actions">
                <a class="btn primary full" href={`/model/${relatedModel.slug}`}>
                  Harga & Spesifikasi {relatedModel.name} →
                </a>
                <a class="btn secondary full" href={`/test-drive?model=${relatedModel.slug}`}>
                  Booking Test Drive
                </a>
              </div>
            </div>
          )}

          <div class="side-card dealer-cta-card">
            <span class="side-eyebrow">BYD Asia Afrika Bandung</span>
            <h3>Konsultasi Promo & Simulasi Kredit</h3>
            <p>Dapatkan penawaran OTR Bandung terbaru, hitungan DP ringan, dan jadwal test drive unit BYD pilihan Anda.</p>
            <a
              class="btn accent full"
              href={waLink(`Halo BYD Asia Afrika Bandung, saya ingin konsultasi promo & harga setelah membaca "${article.title}".`)}
              target="_blank"
              rel="noopener"
            >
              Chat Sales via WhatsApp
            </a>
          </div>

          {relatedArticles.length > 0 && (
            <div class="side-card">
              <span class="side-eyebrow">Baca Juga</span>
              <ul class="related-list">
                {relatedArticles.map((rel) => (
                  <li>
                    <a href={`/berita/${primaryCategory(rel)}/${rel.slug}`}>
                      <span class="rel-title">{rel.title}</span>
                      <span class="rel-date">{formatTanggal(rel.date)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-page {
    padding: 24px 0 56px;
    background: var(--surface, #f8fafc);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.84rem;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .breadcrumb .current {
    color: var(--ink);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 340px;
  }

  /* Header Artikel */
  .article-header {
    margin-bottom: 24px;
  }
  .meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .cat-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cat-pill {
    background: var(--ink);
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.72rem;
    padding: 4px 11px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .cat-pill:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .meta-date {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .article-title {
    margin: 0 0 10px;
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .article-lead {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--muted);
    max-width: 82ch;
  }

  /* Grid 2 Kolom Sejajar Container Single Model */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 32px;
    }
  }

  .featured-media {
    margin: 0 0 20px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #fff;
    box-shadow: 0 6px 24px rgba(15, 23, 42, 0.06);
  }
  .featured-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .article-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px 20px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
  }
  @media (min-width: 768px) {
    .article-card {
      padding: 34px 40px;
    }
  }

  /* Tipografi Konten Artikel: Rapat, Nyaman Dibaca, Tanpa Gap Kosong Berlebih */
  .article-body {
    font-size: 1.02rem;
    line-height: 1.68;
    color: #1e293b;
  }
  .article-body :global(p) {
    margin: 0 0 0.95rem;
  }
  .article-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .article-body :global(br + br) {
    display: none;
  }
  .article-body :global(h2) {
    margin: 1.65rem 0 0.6rem;
    font-size: 1.35rem;
    line-height: 1.3;
    color: var(--ink);
    padding-top: 0.4rem;
    border-top: 1px solid #f1f5f9;
  }
  .article-body :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .article-body :global(h3) {
    margin: 1.25rem 0 0.45rem;
    font-size: 1.12rem;
    line-height: 1.35;
    color: var(--ink);
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.3rem;
  }
  .article-body :global(li) {
    margin-bottom: 0.35rem;
  }
  .article-body :global(a) {
    color: #0284c7;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Blok FAQ Modern */
  .article-faq {
    margin-top: 2.2rem;
    padding-top: 1.75rem;
    border-top: 2px solid #f1f5f9;
  }
  .faq-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--accent-ink);
    margin-bottom: 6px;
  }
  .article-faq h2 {
    margin: 0 0 1rem;
    font-size: 1.3rem;
    color: var(--ink);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .faq-item {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #f8fafc;
    overflow: hidden;
    transition: border-color 0.15s, background 0.15s;
  }
  .faq-item[open] {
    background: #fff;
    border-color: #94a3b8;
  }
  .faq-item summary {
    padding: 14px 16px;
    font-weight: 700;
    font-size: 0.96rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    color: var(--ink);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #e2e8f0;
    display: grid;
    place-items: center;
    font-size: 1.1rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .faq-item[open] summary::after {
    content: '−';
    background: var(--ink);
    color: #fff;
  }
  .faq-answer {
    padding: 0 16px 14px;
  }
  .faq-answer p {
    margin: 0;
    color: #475569;
    font-size: 0.94rem;
    line-height: 1.6;
  }

  /* Sidebar Kanan */
  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  @media (min-width: 960px) {
    .article-sidebar {
      position: sticky;
      top: 84px;
    }
  }
  .side-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }
  .side-eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .side-card h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .side-model-img {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 10px;
    border: 1px solid var(--border);
  }
  .side-model-img :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .side-tagline {
    margin: 0 0 14px;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .side-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .btn.full {
    width: 100%;
    text-align: center;
    justify-content: center;
  }
  .dealer-cta-card {
    background: linear-gradient(145deg, #0f172a 0%, #1e293b 100%);
    color: #fff;
    border: none;
  }
  .dealer-cta-card .side-eyebrow {
    color: var(--accent);
  }
  .dealer-cta-card h3 {
    color: #fff;
  }
  .dealer-cta-card p {
    margin: 0 0 14px;
    font-size: 0.88rem;
    color: #cbd5e1;
    line-height: 1.55;
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .related-list li + li {
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
  }
  .related-list a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .rel-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
  }
  .related-list a:hover .rel-title {
    text-decoration: underline;
  }
  .rel-date {
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>