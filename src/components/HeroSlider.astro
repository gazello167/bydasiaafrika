---
import Icon from './Icon.astro';
import Pic from './Pic.astro';
import { slides } from '../data/slides';
---
<section class="hero-slider" data-slider aria-roledescription="carousel" aria-label="Promo dan info terbaru">
  <div class="slides" data-track>
    {slides.map((s, i) => (
      <article class="slide" aria-roledescription="slide" aria-label={`${i + 1} dari ${slides.length}`}>
        {s.image && (
          <div class="pic">
            <Pic src={s.image} alt="" width={1600} eager={i === 0} />
          </div>
        )}
        <div class="slide-body">
          <div class="copy">
            <p class="eyebrow">{s.eyebrow}</p>
            {i === 0 ? <h1>{s.title}</h1> : <h2>{s.title}</h2>}
            <p>{s.text}</p>
            <a class="btn accent" href={s.cta.href}>{s.cta.label}</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  {slides.length > 1 && (
    <>
      <button class="slider-btn prev" type="button" aria-label="Slide sebelumnya" data-prev>
        <Icon name="left" />
      </button>
      <button class="slider-btn next" type="button" aria-label="Slide berikutnya" data-next>
        <Icon name="right" />
      </button>
      <div class="slider-dots">
        {slides.map((_, i) => (
          <button class="dot" type="button" aria-label={`Ke slide ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} data-dot={i}></button>
        ))}
      </div>
    </>
  )}
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-slider]');
  const track = root?.querySelector<HTMLElement>('[data-track]');

  if (root && track) {
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const count = track.children.length;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: number | undefined;

    const go = (i: number) => {
      const n = (i + count) % count;
      track.scrollTo({ left: n * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    };

    track.addEventListener(
      'scroll',
      () => {
        index = Math.round(track.scrollLeft / track.clientWidth);
        dots.forEach((d, i) => d.setAttribute('aria-current', String(i === index)));
      },
      { passive: true },
    );

    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));

    // Autoplay: berhenti saat disentuh/hover/fokus, tidak jalan jika user minta gerak minimal
    const start = () => {
      if (reduce || count < 2) return;
      stop();
      timer = window.setInterval(() => !document.hidden && go(index + 1), 6000);
    };
    const stop = () => window.clearInterval(timer);

    ['pointerenter', 'focusin', 'touchstart'].forEach((ev) => root.addEventListener(ev, stop, { passive: true }));
    ['pointerleave', 'focusout', 'touchend'].forEach((ev) => root.addEventListener(ev, start, { passive: true }));
    start();
  }
</script>
