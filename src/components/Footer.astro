---
import { site, waLink } from '../data/site';

const social = (site.social || {}) as Record<string, string>;
const rawPhone = String(site.phone || '').replace(/[^0-9+]/g, '');
const telHref = rawPhone.startsWith('0') ? `tel:+62${rawPhone.slice(1)}` : `tel:${rawPhone}`;

const socialLinks = [
  {
    key: 'facebook',
    label: 'Facebook',
    href: social.facebook || '',
    svg: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
  {
    key: 'instagram',
    label: 'Instagram',
    href: social.instagram || '',
    svg: '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  },
  {
    key: 'threads',
    label: 'Threads',
    href: social.threads || '',
    svg: '<path d="M19 12a7 7 0 1 0-2.1 5"/><path d="M14.5 11.5c-.2-1.8-1.4-2.8-3-2.8-1.9 0-3.2 1.4-3.2 3.4 0 2 1.3 3.3 3.2 3.3 1.6 0 2.7-.9 3-2.3.2-1 .1-2.2-.8-2.8-.8-.5-2-.3-2.5.4-.4.6-.3 1.5.3 1.9.6.4 1.4.2 1.8-.3"/>',
  },
  {
    key: 'pinterest',
    label: 'Pinterest',
    href: social.pinterest || '',
    svg: '<circle cx="12" cy="12" r="10"/><path d="M8 20l4-9"/><path d="M10.7 14c.437 1.263 1.43 2 2.55 2c2.071 0 3.75 -1.554 3.75 -4a5 5 0 1 0 -9.7 1.7"/>',
  },
];
---

<footer class="home-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Kolom 1: Gambar Dealer, Nama, Alamat, Kontak & Link ke Kontak -->
      <div class="footer-col">
        <div class="dealer-photo">
          <img
            src="https://byd.gazello.my.id/images/dealer-byd-asia-afrika-bandung.webp"
            alt={`Showroom ${site.name}`}
            width="420"
            height="240"
            loading="lazy"
          />
        </div>

        <h3 class="footer-title">{site.name}</h3>
        {site.legalName && <p class="footer-legal">{site.legalName}</p>}

        <address class="footer-address">
          {site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}
        </address>

        <ul class="footer-contact-list">
          <li>
            <span>Telepon:</span>
            <a href={telHref}>{site.phone}</a>
          </li>
          <li>
            <span>WhatsApp:</span>
            <a href={waLink('Halo BYD Asia Afrika Bandung, saya ingin konsultasi promo & unit BYD.')} target="_blank" rel="noopener">
              Chat Sales ({site.phone})
            </a>
          </li>
          {site.email && (
            <li>
              <span>Email:</span>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </li>
          )}
        </ul>

        <a class="footer-kontak-link" href="/kontak">
          Lihat Detail Kontak & Jam Operasional →
        </a>
      </div>

      <!-- Kolom 2: Google Maps Embed Lokasi Dealer -->
      <div class="footer-col">
        <h3 class="footer-heading">Lokasi Showroom</h3>
        <div class="footer-map-box">
          <iframe
            src={site.mapsEmbedUrl}
            title={`Peta Lokasi ${site.name}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <!-- Kolom 3: Sosial Media (Facebook, Instagram, Threads, Pinterest) -->
      <div class="footer-col">
        <h3 class="footer-heading">Ikuti Kami</h3>
        <p class="footer-soc-desc">
          Dapatkan update unit terbaru, promo BYD Bandung, dan jadwal pameran resmi melalui kanal sosial media kami.
        </p>

        <div class="footer-socials">
          {socialLinks.map((s) => (
            <a
              href={s.href || '#'}
              class={`soc-btn ${!s.href ? 'is-empty' : ''}`}
              aria-label={s.label}
              title={s.label}
              target={s.href ? '_blank' : undefined}
              rel={s.href ? 'noopener noreferrer' : undefined}
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={s.svg}
              />
              <span>{s.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .home-footer {
    background: var(--ink-2, #181a1f);
    color: #e5e7eb;
    padding: 48px 0 44px;
    border-top: 3px solid var(--accent, #b4d233);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.15fr 1.2fr 0.85fr;
      gap: 28px;
    }
  }

  /* Kolom 1 */
  .dealer-photo {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    margin-bottom: 14px;
    aspect-ratio: 16 / 9;
    background: #0f1115;
  }
  .dealer-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .footer-title {
    margin: 0 0 2px;
    font-size: 1.15rem;
    color: #ffffff;
  }
  .footer-legal {
    margin: 0 0 10px;
    font-size: 0.84rem;
    color: var(--accent, #b4d233);
    font-weight: 600;
  }
  .footer-address {
    font-style: normal;
    font-size: 0.9rem;
    line-height: 1.55;
    color: #cbd5e1;
    margin-bottom: 12px;
  }

  .footer-contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.88rem;
  }
  .footer-contact-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .footer-contact-list span {
    color: #94a3b8;
  }
  .footer-contact-list a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
  }
  .footer-contact-list a:hover {
    color: var(--accent, #b4d233);
    text-decoration: underline;
  }

  .footer-kontak-link {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #ffffff;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .footer-kontak-link:hover {
    background: var(--accent, #b4d233);
    border-color: var(--accent, #b4d233);
    color: var(--accent-ink, #181a1f);
  }

  /* Kolom 2: Map Embed */
  .footer-heading {
    margin: 0 0 12px;
    font-size: 1.05rem;
    color: #ffffff;
    letter-spacing: 0.01em;
  }
  .footer-map-box {
    width: 100%;
    height: 270px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #0f1115;
  }
  @media (min-width: 768px) {
    .footer-map-box {
      height: 310px;
    }
  }
  .footer-map-box iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Kolom 3: Sosial Media */
  .footer-soc-desc {
    margin: 0 0 14px;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #cbd5e1;
  }
  .footer-socials {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  @media (min-width: 768px) {
    .footer-socials {
      grid-template-columns: 1fr;
    }
  }
  .soc-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .soc-btn:hover {
    background: var(--accent, #b4d233);
    border-color: var(--accent, #b4d233);
    color: var(--accent-ink, #181a1f);
    transform: translateX(3px);
  }
</style>