---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="copyright">
  <div class="container">
    <p>&copy; {year} <a href="/">{site.name}</a>. {site.disclaimer}</p>
  </div>
</footer>

<style>
footer.copyright {
    background: var(--ink);
    color: #c9ccd1;
    padding: 1px 0;
    font-size: .7rem;
}
</style>